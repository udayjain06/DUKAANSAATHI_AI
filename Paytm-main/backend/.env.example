# DukaanSaathi AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./dukaansaathi.db

# Paytm Payment Gateway (get from https://business.paytm.com/)
PAYTM_MID=your_merchant_id_here
PAYTM_MERCHANT_KEY=your_merchant_key_here
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PAYTM_CALLBACK_URL=http://localhost:8000/api/payment/callback
PAYTM_CHANNEL_ID=WEB

# App Settings
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI (Claude API - Member 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Risk Budget (INR)
DEFAULT_RISK_BUDGET=400
DEFAULT_MIN_MARGIN_PCT=15

