# DukaanSaathi / Paytm AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite default for local dev, PostgreSQL for Supabase / Production)
DATABASE_URL=sqlite:///./dukaansaathi.db

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq Conversational AI (Get key from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Paytm Payment Gateway (Get staging credentials from https://business.paytm.com/)
PAYTM_MID=your_merchant_id_here
PAYTM_MERCHANT_KEY=your_merchant_key_here
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PAYTM_CALLBACK_URL=http://localhost:8000/api/payment/callback
PAYTM_CHANNEL_ID=WEB

# App Settings
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Fallback (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Risk Budget & Margin Defaults
DEFAULT_RISK_BUDGET=400
DEFAULT_MIN_MARGIN_PCT=15
