# ==============================================================================
# DukaanSaathi AI / Paytm Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE
# ------------------------------------------------------------------------------
# SQLite default for local development:
DATABASE_URL=sqlite:///./dukaansaathi.db
#
# Supabase Transaction Pooler (port 6543) example:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. GROQ AI (optional - deterministic local fallbacks are used without a key)
# ------------------------------------------------------------------------------
# Get a free API key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. PAYTM PAYMENT GATEWAY (optional - required for payments)
# ------------------------------------------------------------------------------
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_ENV=staging
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_CALLBACK_URL=https://your-backend.onrender.com/api/payment/callback
