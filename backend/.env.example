# ==============================================================================
# DukaanSaathi AI / Paytm Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
APP_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE (REQUIRED FOR PERSISTENCE / SUPABASE)
# ------------------------------------------------------------------------------
# SQLite default for local development:
# DATABASE_URL=sqlite:///./dukaansaathi.db
#
# Supabase Transaction Pooler (Port 6543) or Direct Connection (Port 5432):
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./dukaansaathi.db

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH & CLIENT (OPTIONAL - Enables Supabase User Management)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 4. GROQ CONVERSATIONAL AI (OPTIONAL - Enables High-Speed LLaMA Assistant)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. PAYTM PAYMENT GATEWAY (OPTIONAL - Required for Live/Staging Payments)
# ------------------------------------------------------------------------------
# Obtain test merchant credentials from: https://business.paytm.com/
PAYTM_MID=your_paytm_merchant_id_here
PAYTM_MERCHANT_KEY=your_paytm_merchant_key_here
PAYTM_ENV=staging
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_CALLBACK_URL=https://your-backend.onrender.com/api/payment/callback

# ------------------------------------------------------------------------------
# 6. BUSINESS ENGINE CONFIGURATION (OPTIONAL - Defaults applied if omitted)
# ------------------------------------------------------------------------------
DEFAULT_RISK_BUDGET=400
DEFAULT_MIN_MARGIN_PCT=15
